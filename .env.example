# ---------------------------------------------------------------------------
# AutoVless configuration. Copy to .env and fill in the first two values.
# ---------------------------------------------------------------------------

# Required: token from @BotFather
BOT_TOKEN=

# Required: comma separated Telegram numeric ids that get the admin panel
ADMIN_IDS=

# Branding and links shown in the bot
BRAND=AutoVless
SUPPORT_URL=https://t.me/AutoVless
CHANNEL_URL=https://t.me/AutoVless
GITHUB_URL=https://github.com/arjeyproject/AutoVless

# fa or en
DEFAULT_LANG=fa

# How many configs to build, and on which Cloudflare edge ports.
#
# Give each group more than one port. A group used to sit entirely on its first
# port, so the day 443 was filtered on someone's network their whole TLS set went
# dark at once. Cloudflare serves TLS on 443, 2053, 2083, 2087, 2096 and 8443, and
# plain HTTP on 80, 8080, 8880, 2052, 2082, 2086 and 2095. Every extra port also
# costs a sweep, so three and two is a good balance on a small box.
TLS_CONFIG_COUNT=5
HTTP_CONFIG_COUNT=3
TLS_PORTS=443,2053,8443
HTTP_PORTS=80,8080

# ---------------------------------------------------------------------------
# Verification: what an endpoint has to prove before a user sees it
#
# With VERIFY_WS on, an address is only stored as verified once it completes the
# client's own handshake: TLS with a real panel hostname as the SNI, then a
# WebSocket upgrade answered with 101. Anything weaker verifies a conversation
# nobody is going to have, which is exactly how port 443 used to ship configs
# that could not ping.
#
# VERIFY_HOST pins the hostname to verify against. Leave it blank and the newest
# successful deploy records itself automatically; until the first panel exists,
# the weaker cold-start check runs and says so in the log.
# ---------------------------------------------------------------------------
VERIFY_WS=true
VERIFY_HOST=

# Deploy-time acceptance: every endpoint about to ship is handshaked against the
# panel's own hostname, and failures are replaced from the pool. ACCEPT_RETRIES
# is how many replacement rounds are allowed before the panel ships short, which
# it will do on purpose: four configs that ping beat nine that do not.
ACCEPT_TIMEOUT_MS=8000
ACCEPT_RETRIES=2

# ---------------------------------------------------------------------------
# Clean IP scanner. Defaults are tuned for 1 vCPU / 1 GB RAM.
#
# Each sweep runs up to SCAN_WAVES passes per port, growing the random batch
# every time, until the port holds SCAN_MIN_VERIFIED verified addresses of its
# own. Every shortlisted address is then probed SCAN_ROUNDS times: the spread
# between those probes becomes jitter, and jitter is weighted heavily in the
# score because a wobbly entry point is worse than a slower steady one.
# ---------------------------------------------------------------------------
SCAN_INTERVAL=600
SCAN_BATCH=900
SCAN_CONCURRENCY=160
SCAN_TIMEOUT_MS=1400
VERIFY_TOP=28
SCAN_ROUNDS=3
SCAN_WAVES=3
SCAN_MIN_VERIFIED=8

# Pool size. POOL_SIZE is the whole pool's budget for the trim that runs after
# every sweep; POOL_TARGET is the floor each individual port is held at, counted
# in *fresh verified* rows. The trim never takes a port below the target, so the
# pool the curator grows is not thrown away an hour later, and any port under the
# target is what makes the curator ask for another sweep.
POOL_SIZE=720
POOL_TARGET=40

# Endpoints are dropped after this many failed live checks
MAX_FAILS=3

# ---------------------------------------------------------------------------
# Pool curator: the agent that deletes what stopped pinging
#
# Full write-up in docs/curator.md. Every CURATOR_INTERVAL seconds it rechecks
# CURATOR_BATCH stored addresses on the exact port a client will use, with the
# client's own TLS SNI and WebSocket upgrade, then:
#
#   * keeps what answers and improves its record
#   * DELETES what does not: CURATOR_STRIKES misses in a row, or a reliability
#     under CURATOR_FLOOR once CURATOR_MIN_SAMPLES samples back it up, or nothing
#     confirmed at all for CURATOR_STALE seconds. Deleted, not hidden: a demoted
#     row is still a row that gets handed out again later
#   * asks the sweep to refill every port left under POOL_TARGET
#   * re-points any panel that was serving a deleted address, right away, same
#     subscription link
#
# CURATOR_ABORT is the safety valve. If that share of a batch misses, the problem
# is this box or the reference panel, not the addresses, so nothing is purged that
# cycle. A bad night on the server can never empty your pool.
# ---------------------------------------------------------------------------
CURATOR=true
CURATOR_INTERVAL=300
CURATOR_BATCH=160
CURATOR_RECHECK=900
CURATOR_ROUNDS=3
CURATOR_REQUIRED=2
CURATOR_STRIKES=3
CURATOR_FLOOR=0.4
CURATOR_MIN_SAMPLES=5
CURATOR_STALE=14400
CURATOR_ABORT=0.85
CURATOR_PUSH=true
CURATOR_PUSH_BATCH=6

# Curated clean IP lists mixed into every sweep. Comma separated, blank to
# disable. The old ipdb.030101.xyz/api/*.txt paths answer 200 with an HTML page,
# so anything still pointed at them is silently running with no seeds.
CLEAN_IP_SOURCES=https://ipdb.api.030101.xyz/?type=bestcf,https://raw.githubusercontent.com/ymyuuu/IPDB/main/bestcf.txt

# Seed files on disk, read on every sweep. .github/workflows/clean-ips.yml
# publishes endpoints/clean-ips.txt every three hours, which is what makes a
# fresh deployment start warm instead of blind. Works the same on a private repo.
CLEAN_IP_FILES=endpoints/clean-ips.txt

# Hostnames kept pointed at healthy Cloudflare edges by the community. One of
# these rides along on every panel: the address behind it is replaced upstream,
# so that config keeps working long after raw IPs go stale. Blank to disable.
CLEAN_DOMAINS=cf.090227.xyz,cdn.xn--b6gac.eu.org,cf.877774.xyz,cfip.cfcdn.eu.org

# ---------------------------------------------------------------------------
# Live subscription blending
#
# The Worker fetches these lists itself, through the Cloudflare edge cache, and
# mixes fresh addresses into the subscription it serves. That is what makes
# clean IPs automatic: a client pressing Update gets today's entry points
# without anyone rebuilding a panel. Defaults to CLEAN_IP_SOURCES.
# ---------------------------------------------------------------------------
SUB_SOURCES=
SUB_REFRESH=300

# ---------------------------------------------------------------------------
# proxyIP relays
#
# A Worker cannot open a socket to a Cloudflare owned address, so every site
# that sits behind Cloudflare needs a relay. Leave PROXY_IP empty to use the
# built in seed list, or pin your own: "1.2.3.4:443,relay.example.com".
#
# RELAY_STRIKES is how many failed checks a relay gets before it is deleted
# rather than demoted. A dead relay at the head of a failover chain makes every
# session pay its timeout first, which users report as "connects but nothing
# loads".
#
# PROXY_PER_PANEL moved from 4 to 6 because the chain is no longer a quiet
# fallback: AI destinations are routed through it, so it is load bearing now.
# ---------------------------------------------------------------------------
PROXY_IP=
PROXY_IP_SOURCES=https://ipdb.api.030101.xyz/?type=bestproxy,https://raw.githubusercontent.com/ymyuuu/IPDB/main/bestproxy.txt
PROXY_PORTS=443
PROXY_SCAN_INTERVAL=1800
PROXY_SCAN_LIMIT=240
PROXY_POOL_SIZE=40
# How many relays are baked into each panel as an ordered failover chain
PROXY_PER_PANEL=6
RELAY_STRIKES=3

# ---------------------------------------------------------------------------
# AI destinations: ChatGPT, Gemini, Claude and friends
#
# Two separate problems, one fix.
#
# First, reachability. chatgpt.com, openai.com, claude.ai and perplexity.ai are
# all Cloudflare-fronted, and a Worker cannot open a socket to a Cloudflare
# address at all. The direct attempt cannot succeed - it can only burn the
# connect timeout, which on a Worker is often the whole request budget. That is
# why "everything works except ChatGPT" was the most common report. These hosts
# now go relay-first.
#
# Second, the exit address. Gemini is reachable directly, but a Cloudflare
# datacentre egress that changes on every request reads as account abuse: the
# site logs you out and starts asking for verification. So each domain is pinned
# deterministically to one relay and stays there.
#
# AI_PROXY_IP is the hard guarantee. Put a literal IP here - a proxyIP host you
# control or trust - and every AI destination leaves through that one address.
# Prefer an IP over a hostname: a hostname whose DNS rotates gives away the
# steady address this whole path exists for. Leave it blank and the pin is
# derived from PROXY_IP instead, which is stable for as long as that relay lives.
#
# AI_DOMAINS adds to the built-in list, it does not replace it.
# AI_ROUTE=false turns the whole behaviour off.
#
# Existing panels keep their old worker until it is re-uploaded. Press "apply
# fresh IPs" in the panel, or let the autopilot come round.
# ---------------------------------------------------------------------------
AI_ROUTE=true
AI_PROXY_IP=
AI_DOMAINS=
# How many relays from the chain the AI path may use (1-4). Two is a pinned
# primary plus one spare; more than that starts to defeat the point.
AI_RELAYS=2

# ---------------------------------------------------------------------------
# WARP / WireGuard engine
#
# Endpoints are probed with a real WireGuard handshake, because WARP answers
# nothing else. Survivors are probed again a beat later, so tunnels that DPI
# tears down mid-stream never reach a user. A single lost datagram is retried
# before an endpoint is written off.
#
# The bot asks which device before it builds anything, and that decides the shape
# of the file:
#
#   * Android and Windows get AmneziaWG. The junk train (Jc/Jmin/Jmax) hides the
#     handshake while packet headers stay standard, which is what keeps it
#     compatible with Cloudflare's own unmodified WireGuard peers.
#   * iPhone, iPad and macOS get clean, standard WireGuard. This is not a
#     preference. The official WireGuard app on those platforms is a strict INI
#     parser: it meets Jc inside [Interface], decides the file is not a WireGuard
#     config, and refuses all of it. That single fact is why iPhone users
#     reported the protocol did not run at all.
#
# So WARP_AMNEZIA=true no longer means "everybody gets junk". It means "emit junk
# wherever the client can actually parse it".
# ---------------------------------------------------------------------------
WARP_ENABLED=true
WARP_AMNEZIA=true

# 1280 is the safe default and the ceiling for iOS. Drop to 1200 if pages hang
# after connecting.
WARP_MTU=1280
WARP_DNS=1.1.1.1, 1.0.0.1

# Optional WARP+ license applied to every new identity. Leave blank for free WARP.
WARP_LICENSE=

# Leave empty to auto-discover which of the 54 WARP UDP ports your box can reach
WARP_PORTS=

WARP_SCAN_INTERVAL=1800
# Addresses sampled per /24 pool on every sweep
WARP_SCAN_SAMPLE=6
WARP_SCAN_CONCURRENCY=64
WARP_SCAN_TIMEOUT_MS=2500
# Spaced handshakes each survivor has to answer
WARP_SCAN_ATTEMPTS=2
# How many of the fastest answers get the stability re-probe
WARP_VERIFY_TOP=16
WARP_POOL_SIZE=60
# Endpoints baked into each user's config as a failover list
WARP_PER_CONFIG=4

# Resolver the Worker uses for UDP/53 traffic
DNS_SERVER=8.8.8.8

# Shown on the Worker landing page
FALLBACK_HOST=www.wikipedia.org

# How many times to poll a fresh workers.dev hostname before giving up
HEALTH_ATTEMPTS=6

# Keep encrypted Cloudflare tokens so rebuild, delete and autopilot work
# without re-asking. Turning this off disables the autopilot for new panels,
# and with it the curator's ability to re-point a panel automatically.
STORE_TOKENS=true

# Leave empty to auto-generate on first run (stored in data/.secret)
SECRET_KEY=

LOG_LEVEL=INFO
