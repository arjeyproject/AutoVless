# ---------------------------------------------------------------------------
# AutoVless configuration. Copy to .env and fill in the first two values.
# ---------------------------------------------------------------------------

# Required: token from @BotFather
BOT_TOKEN=

# Required: comma separated Telegram numeric ids that get the admin panel
ADMIN_IDS=

# Branding and links shown in the bot
BRAND=AutoVless
SUPPORT_URL=https://t.me/AutoVless
CHANNEL_URL=https://t.me/AutoVless
GITHUB_URL=https://github.com/arjeyproject/AutoVless

# fa or en
DEFAULT_LANG=fa

# How many configs to build, and on which Cloudflare edge ports.
# Both groups are scanned and verified separately, so a plain HTTP config is
# never pinned to an address that was only ever tested on 443.
TLS_CONFIG_COUNT=4
HTTP_CONFIG_COUNT=2
TLS_PORTS=443
HTTP_PORTS=80

# ---------------------------------------------------------------------------
# Clean IP scanner. Defaults are tuned for 1 vCPU / 1 GB RAM.
#
# Each sweep runs up to SCAN_WAVES passes per port, growing the random batch
# every time, until the port holds SCAN_MIN_VERIFIED verified addresses of its
# own. Every shortlisted address is then probed VERIFY_PROBES times: the spread
# between those probes becomes jitter, and jitter is weighted heavily in the
# score because a wobbly entry point is worse than a slower steady one.
# ---------------------------------------------------------------------------
SCAN_INTERVAL=600
SCAN_BATCH=900
SCAN_CONCURRENCY=160
SCAN_TIMEOUT_MS=1200
VERIFY_TOP=28
VERIFY_PROBES=2
SCAN_WAVES=3
SCAN_MIN_VERIFIED=8
POOL_SIZE=120
# Endpoints are dropped after this many failed live checks
MAX_FAILS=3

# Curated clean IP lists mixed into every sweep. Comma separated, blank to disable.
CLEAN_IP_SOURCES=https://ipdb.030101.xyz/api/bestcf.txt

# Hostnames kept pointed at healthy Cloudflare edges by the community. One of
# these rides along on every panel: the address behind it is replaced upstream,
# so that config keeps working long after raw IPs go stale. Blank to disable.
CLEAN_DOMAINS=cf.090227.xyz,cdn.xn--b6gac.eu.org,cf.877774.xyz,cfip.cfcdn.eu.org

# ---------------------------------------------------------------------------
# Live subscription blending
#
# The Worker fetches these lists itself, through the Cloudflare edge cache, and
# mixes fresh addresses into the subscription it serves. That is what makes
# clean IPs automatic: a client pressing Update gets today's entry points
# without anyone rebuilding a panel. Defaults to CLEAN_IP_SOURCES.
# ---------------------------------------------------------------------------
SUB_SOURCES=
SUB_REFRESH=300

# ---------------------------------------------------------------------------
# Autopilot
#
# Rolling background job that re-uploads each panel's Worker with the current
# best endpoints. The script name and the panel uuid never change, so the
# subscription link the user already holds simply starts serving better
# addresses. Panels are picked oldest-sync-first, a few per cycle, one at a
# time, so a 1 vCPU box stays responsive.
# ---------------------------------------------------------------------------
AUTOPILOT=true
AUTOPILOT_INTERVAL=900
AUTOPILOT_BATCH=6
# Refresh a panel once its endpoints are older than this (seconds)
AUTOPILOT_MAX_AGE=21600

# ---------------------------------------------------------------------------
# proxyIP relays
#
# A Worker cannot open a socket to a Cloudflare owned address, so every site
# that sits behind Cloudflare needs a relay. Leave PROXY_IP empty to use the
# built in seed list, or pin your own: "1.2.3.4:443,relay.example.com".
# ---------------------------------------------------------------------------
PROXY_IP=
PROXY_IP_SOURCES=https://ipdb.030101.xyz/api/bestproxy.txt
PROXY_PORTS=443
PROXY_SCAN_INTERVAL=1800
PROXY_SCAN_LIMIT=240
PROXY_POOL_SIZE=40
# How many relays are baked into each panel as an ordered failover chain
PROXY_PER_PANEL=4

# ---------------------------------------------------------------------------
# WARP / WireGuard engine
#
# Endpoints are probed with a real WireGuard handshake, because WARP answers
# nothing else. Survivors are probed again a beat later, so tunnels that DPI
# tears down mid-stream never reach a user. A single lost datagram is retried
# before an endpoint is written off.
#
# Configs are generated as AmneziaWG: the junk train (Jc/Jmin/Jmax) hides the
# handshake while packet headers stay standard, which is what keeps them
# compatible with Cloudflare's own unmodified WireGuard peers.
# ---------------------------------------------------------------------------
WARP_ENABLED=true
WARP_AMNEZIA=true

# 1280 is the safe default. Drop to 1200 if pages hang after connecting.
WARP_MTU=1280
WARP_DNS=1.1.1.1, 1.0.0.1

# Optional WARP+ license applied to every new identity. Leave blank for free WARP.
WARP_LICENSE=

# Leave empty to auto-discover which of the 54 WARP UDP ports your box can reach
WARP_PORTS=

WARP_SCAN_INTERVAL=1800
# Addresses sampled per /24 pool on every sweep
WARP_SCAN_SAMPLE=6
WARP_SCAN_CONCURRENCY=64
WARP_SCAN_TIMEOUT_MS=2500
# Spaced handshakes each survivor has to answer
WARP_SCAN_ATTEMPTS=2
# How many of the fastest answers get the stability re-probe
WARP_VERIFY_TOP=16
WARP_POOL_SIZE=60
# Endpoints baked into each user's config as a failover list
WARP_PER_CONFIG=4

# Resolver the Worker uses for UDP/53 traffic
DNS_SERVER=8.8.8.8

# Shown on the Worker landing page
FALLBACK_HOST=www.wikipedia.org

# How many times to poll a fresh workers.dev hostname before giving up
HEALTH_ATTEMPTS=6

# Keep encrypted Cloudflare tokens so rebuild, delete and autopilot work
# without re-asking. Turning this off disables the autopilot for new panels.
STORE_TOKENS=true

# Leave empty to auto-generate on first run (stored in data/.secret)
SECRET_KEY=

LOG_LEVEL=INFO
