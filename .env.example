# ---------------------------------------------------------------------------
# AutoVless configuration. Copy to .env and fill in the first two values.
# ---------------------------------------------------------------------------

# Required: token from @BotFather
BOT_TOKEN=

# Required: comma separated Telegram numeric ids that get the admin panel
ADMIN_IDS=

# Branding and links shown in the bot
BRAND=AutoVless
SUPPORT_URL=https://t.me/AutoVless
CHANNEL_URL=https://t.me/AutoVless

# fa or en
DEFAULT_LANG=fa

# How many configs to build, and on which Cloudflare edge ports
# TLS (port 443) is harder to scan, so it defaults higher
TLS_CONFIG_COUNT=5
HTTP_CONFIG_COUNT=3
TLS_PORTS=443
HTTP_PORTS=80

# ---------------------------------------------------------------------------
# Clean IP scanner. Defaults are tuned for 1 vCPU / 1 GB RAM.
#
# The sweep walks every Cloudflare /24 in a fixed shuffled order and saves its
# position in data/sweep.json, so coverage is exhaustive over time and a
# restart resumes instead of starting over.
# ---------------------------------------------------------------------------
SCAN_INTERVAL=600
# Addresses probed per port per sweep
SCAN_BATCH=1200
SCAN_CONCURRENCY=160
SCAN_TIMEOUT_MS=1200
# Addresses sampled inside each /24 the sweep touches
SWEEP_PER_SUBNET=2
# How many of the fastest answers get timed properly and verified
VERIFY_TOP=32
# Handshakes per candidate. It has to answer at least twice; the stored ping is
# the median of the successful rounds, not a single lucky connect.
SCAN_ROUNDS=3
# Seconds an endpoint stays "fresh". Fresh entries outrank fast-but-old ones
# when the pool is trimmed, and panels are rebuilt off fresh entries only.
SCAN_TTL=1800
# Rows older than SCAN_TTL * STALE_FACTOR are deleted outright
STALE_FACTOR=8
# Endpoints kept per port. Trimming is per port: plain HTTP always handshakes
# faster than TLS, so a shared pool starves 443 out of existence.
POOL_SIZE=60

# Curated clean IP lists mixed into every sweep. Comma separated, blank to
# disable. A source that answers with HTML instead of a list is rejected and
# logged, never silently treated as "no results".
CLEAN_IP_SOURCES=https://ipdb.api.030101.xyz/?type=bestcf,https://raw.githubusercontent.com/ymyuuu/IPDB/main/bestcf.txt
# How long a good fetch is cached, and how soon a failed one is retried
SOURCE_TTL=3600
SOURCE_RETRY=300
SEED_LIMIT=400

# ---------------------------------------------------------------------------
# proxyIP relays
#
# A Worker cannot open a socket to a Cloudflare owned address, so every site
# that sits behind Cloudflare needs a relay. Leave PROXY_IP empty to use the
# built in seed list, or pin your own: "1.2.3.4:443,relay.example.com".
# ---------------------------------------------------------------------------
PROXY_IP=
PROXY_IP_SOURCES=https://ipdb.api.030101.xyz/?type=bestproxy,https://raw.githubusercontent.com/ymyuuu/IPDB/main/bestproxy.txt
PROXY_PORTS=443
PROXY_SCAN_INTERVAL=1800
PROXY_SCAN_LIMIT=240
PROXY_POOL_SIZE=40
# How many relays are baked into each panel as an ordered failover chain
PROXY_PER_PANEL=3

# ---------------------------------------------------------------------------
# Panel auto refresh
#
# Pushes the current best endpoints into every panel the bot still holds a
# token for. Same script, same host, same uuid, same subscription URL, so
# clients pick the new addresses up on their next refresh and nobody has to
# press Rebuild. Needs STORE_TOKENS=true.
# ---------------------------------------------------------------------------
REFRESH_ENABLED=true
REFRESH_INTERVAL=3600
# Only rebuild when the pool is at least this many ms faster on average, or
# when the panel's own entry points stop verifying
REFRESH_MIN_GAIN=120
# Pause between panels. This talks to the Cloudflare API on someone else's
# account, so it stays deliberately slow.
REFRESH_GAP=2
# Tell the user when their panel was refreshed
REFRESH_NOTIFY=false

# ---------------------------------------------------------------------------
# WARP / WireGuard engine
#
# Endpoints are probed with a real WireGuard handshake, because WARP answers
# nothing else. Survivors are probed again a beat later, so tunnels that DPI
# tears down mid-stream never reach a user.
#
# Configs are generated as AmneziaWG: the junk train (Jc/Jmin/Jmax) hides the
# handshake while packet headers stay standard, which is what keeps them
# compatible with Cloudflare's own unmodified WireGuard peers.
# ---------------------------------------------------------------------------
WARP_ENABLED=true
WARP_AMNEZIA=true

# 1280 is the safe default. Drop to 1200 if pages hang after connecting.
WARP_MTU=1280
WARP_DNS=1.1.1.1, 1.0.0.1

# Optional WARP+ license applied to every new identity. Leave blank for free WARP.
WARP_LICENSE=

# Leave empty to auto-discover which of the 54 WARP UDP ports your box can reach
WARP_PORTS=

WARP_SCAN_INTERVAL=1800
# Addresses sampled per /24 pool on every sweep
WARP_SCAN_SAMPLE=6
WARP_SCAN_CONCURRENCY=64
WARP_SCAN_TIMEOUT_MS=1500
# How many of the fastest answers get the stability re-probe
WARP_VERIFY_TOP=16
WARP_POOL_SIZE=60
# Endpoints baked into each user's config as a failover list
WARP_PER_CONFIG=4

# Resolver the Worker uses for UDP/53 traffic
DNS_SERVER=8.8.8.8

# Shown on the Worker landing page
FALLBACK_HOST=www.wikipedia.org

# How many times to poll a fresh workers.dev hostname before giving up
HEALTH_ATTEMPTS=6

# Keep encrypted Cloudflare tokens so rebuild, delete and auto refresh work
# without re-asking
STORE_TOKENS=true

# Leave empty to auto-generate on first run (stored in data/.secret)
SECRET_KEY=

LOG_LEVEL=INFO
