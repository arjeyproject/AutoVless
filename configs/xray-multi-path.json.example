{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "vless-reality-main",
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "vless",
      "settings": { "clients": [], "decryption": "none" },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.microsoft.com:443",
          "serverNames": ["www.microsoft.com"],
          "privateKey": "REPLACE_WITH_SECRET",
          "shortIds": ["REPLACE_WITH_SHORT_ID"]
        }
      }
    },
    {
      "tag": "vless-xhttp-fallback",
      "listen": "127.0.0.1",
      "port": 10086,
      "protocol": "vless",
      "settings": { "clients": [], "decryption": "none" },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": { "serverName": "REPLACE_WITH_DOMAIN", "alpn": ["h2", "http/1.1"] },
        "xhttpSettings": { "path": "/REPLACE_WITH_RANDOM_PATH", "mode": "auto" }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" },
    { "protocol": "blackhole", "tag": "blocked" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "blocked" }
    ]
  }
}
